# ============================================================================
# Liquid Glass — Café & Event OS
#
# The web app runs fully standalone on an in-browser demo store (no backend
# required) — just `npm run dev`. The variables below are only needed if you
# wire the app up to a real Supabase/PostgreSQL backend using the schema in
# supabase/migrations/.
# ============================================================================

# Supabase project URL, e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
