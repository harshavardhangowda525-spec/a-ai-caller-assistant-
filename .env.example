# ---- Tribal Brew Daily — environment ----
# Everything is OPTIONAL for local preview: the site renders from seed data
# and the admin runs in read-only "demo mode" until Supabase is configured.

# Public site URL (used for SEO canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://tribalbrew.coffee

# ---- Supabase (enables live content + persistence) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin dashboard login ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# Secret used to sign admin session cookies (use a long random string)
AUTH_SECRET=replace-with-a-long-random-string

# ---- POS ----
# GST / tax rate applied at checkout (percent)
NEXT_PUBLIC_TAX_RATE=5
