# ============================================================================
# Infinity AI Caller — Environment Configuration
# Copy to `.env.local` and fill in real values. NEVER commit real credentials.
# ============================================================================

# --- Application ---
# Public base URL of the deployed app (used to build webhook callback URLs).
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# --- Database (PostgreSQL / Supabase) ---
DATABASE_URL=postgresql://user:password@localhost:5432/infinity_caller

# --- Supabase ---
# SUPABASE_URL and NEXT_PUBLIC_SUPABASE_URL should be the same project URL.
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon key is safe for the browser (RLS enforced). Service role key is SERVER-ONLY.
SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Telephony provider ---
# Supported values: mock | twilio | exotel
# Use `mock` for local development (no real calls are placed).
TELEPHONY_PROVIDER=mock
TELEPHONY_API_KEY=
TELEPHONY_API_SECRET=
# Some providers (Exotel) require an account SID / subdomain.
TELEPHONY_ACCOUNT_SID=
TELEPHONY_SUBDOMAIN=
# Shared secret used to verify inbound webhook signatures where the provider
# does not sign natively. Generate a long random string.
TELEPHONY_WEBHOOK_SECRET=

# --- Caller ID & transfer (SERVER-ONLY — never exposed to the browser) ---
# The outbound caller ID MUST be a number legally verified/registered with the
# selected telephony provider for Indian outbound calling. The app will NOT
# spoof — if the provider cannot use it, a configuration error is shown.
OUTBOUND_CALLER_ID=6360471652
# The owner/sales number that answered "interested" leads are transferred to.
OWNER_TRANSFER_NUMBER=6360471652

# --- AI provider ---
# Supported values: mock | anthropic
AI_PROVIDER=mock
AI_API_KEY=
# Default model id when AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5

# --- Real-time voice (TTS + STT) — required only for full AI voice calls ---
# See docs/GOING_LIVE.md. Leave as `mock` until real engines are wired up.
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_VOICE=
STT_PROVIDER=mock
STT_API_KEY=
STT_LANGUAGE=en-IN

# --- Auth / sessions ---
# Supabase handles auth. This secret is used to sign internal worker requests.
INTERNAL_WORKER_SECRET=change-me-to-a-long-random-string
